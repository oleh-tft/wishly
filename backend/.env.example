# Copy to backend/.env for local development (never commit .env)

# Same Client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=512670650651-caal9362f0bqmtkajerd2v0jqtkl97i5.apps.googleusercontent.com

# From Google Cloud Console → Credentials → OAuth client → Client secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Local frontend URL
FRONTEND_URL=http://localhost:5173

# Must match Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

JWT_SECRET_KEY=dev-secret-change-me
